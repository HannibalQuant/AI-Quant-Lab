//@version=6
// AI Quant Lab — Research Run #3 — Frozen Candidate #2
// Governed main baseline: 0b66ae82b776693cb20054801eccedc45191b7d6
// Research decision: RESEARCH_OOS_PASS_WITH_DOCUMENTED_SHORT_SIDE_LIMITATION
// Deployment: NOT_AUTHORIZED
// Execution: PLANNED_CLOSED
// Execution semantics: confirmed bars; entries/exits execute on the next bar open.
// Governed slippage: DECLARED_BPS 5 bps; Pine strategy() slippage is tick-based,
// so no false bps-to-tick conversion is emitted here.

strategy(
    "AIQL RR3 SOLUSDT 4H Candidate 2",
    initial_capital=1000,
    pyramiding=0,
    process_orders_on_close=false,
    calc_on_every_tick=false,
    default_qty_type=strategy.cash,
    default_qty_value=100,
    commission_type=strategy.commission.percent,
    commission_value=0.1
)

// ===== Frozen RR3 Candidate #2 parameters =====
fastEmaLength = 12
mediumEmaLength = 72
slowEmaLength = 160

rsiLength = 10
rsiLongMin = 61.0
rsiShortMax = 38.0

macdFastLength = 7
macdSlowLength = 49
macdSignalLength = 17

adxLength = 14
adxThreshold = 20.0

atrLength = 14
atrStopMult = 2.5
takeProfitR = 2.0
breakEvenTriggerR = 1.0
timeStopBars = 18

// RR3 regime filters
emaSeparationMinPct = 0.2
adxSlopeLength = 1
atrPctMin = 0.5
atrPctMax = 4.0

// ===== Indicators =====
fastEma = ta.ema(close, fastEmaLength)
mediumEma = ta.ema(close, mediumEmaLength)
slowEma = ta.ema(close, slowEmaLength)

rsiValue = ta.rsi(close, rsiLength)
[macdLine, macdSignalLine, _] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)
[plusDI, minusDI, adxValue] = ta.dmi(adxLength, adxLength)
atrValue = ta.atr(atrLength)

// ===== RR3 filters =====
emaSeparationPct = close > 0 ? math.abs(fastEma - slowEma) / close * 100.0 : na
atrPct = close > 0 ? atrValue / close * 100.0 : na

antiChopOk = not na(emaSeparationPct) and emaSeparationPct >= emaSeparationMinPct
volatilityRegimeOk = not na(atrPct) and atrPct >= atrPctMin and atrPct <= atrPctMax
adxSlopeOk = not na(adxValue[adxSlopeLength]) and adxValue > adxValue[adxSlopeLength]
regimeOk = antiChopOk and volatilityRegimeOk and adxSlopeOk

// ===== Confirmed-bar signals =====
confirmedBar = barstate.isconfirmed
signalsReady = not na(fastEma) and not na(mediumEma) and not na(slowEma) and not na(rsiValue) and not na(macdLine) and not na(macdSignalLine) and not na(adxValue) and not na(atrValue)

longSignal = confirmedBar and signalsReady and regimeOk and fastEma > mediumEma and mediumEma > slowEma and close > slowEma and rsiValue >= rsiLongMin and macdLine > macdSignalLine and adxValue >= adxThreshold and plusDI > minusDI

shortSignal = confirmedBar and signalsReady and regimeOk and fastEma < mediumEma and mediumEma < slowEma and close < slowEma and rsiValue <= rsiShortMax and macdLine < macdSignalLine and adxValue >= adxThreshold and minusDI > plusDI

// ===== Position state =====
var float entryAtr = na
var int entryBarIndex = na
var bool breakEvenArmed = false

priorPosition = nz(strategy.position_size[1])
newLong = strategy.position_size > 0 and priorPosition <= 0
newShort = strategy.position_size < 0 and priorPosition >= 0
flatNow = strategy.position_size == 0

// The order was generated by the previous confirmed bar, therefore use prior-bar ATR.
if newLong or newShort
    entryAtr := nz(atrValue[1], atrValue)
    entryBarIndex := bar_index
    breakEvenArmed := false
else if flatNow
    entryAtr := na
    entryBarIndex := na
    breakEvenArmed := false

// ===== Entries =====
if flatNow
    if longSignal
        strategy.entry("AIQL-L", strategy.long)
    else if shortSignal
        strategy.entry("AIQL-S", strategy.short)

// ===== LONG management =====
else if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    riskDistance = nz(entryAtr, atrValue) * atrStopMult
    initialStop = entryPrice - riskDistance
    takeProfit = entryPrice + riskDistance * takeProfitR
    barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex

    stopTouched = confirmedBar and low <= initialStop
    targetTouched = confirmedBar and high >= takeProfit
    breakEvenTriggerTouched = confirmedBar and high >= entryPrice + riskDistance * breakEvenTriggerR
    breakEvenStopTouched = breakEvenArmed and confirmedBar and low <= entryPrice

    if stopTouched or targetTouched or breakEvenStopTouched or barsInTrade >= timeStopBars or shortSignal
        strategy.close("AIQL-L")
    else if breakEvenTriggerTouched
        breakEvenArmed := true

// ===== SHORT management =====
else if strategy.position_size < 0
    entryPrice = strategy.position_avg_price
    riskDistance = nz(entryAtr, atrValue) * atrStopMult
    initialStop = entryPrice + riskDistance
    takeProfit = entryPrice - riskDistance * takeProfitR
    barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex

    stopTouched = confirmedBar and high >= initialStop
    targetTouched = confirmedBar and low <= takeProfit
    breakEvenTriggerTouched = confirmedBar and low <= entryPrice - riskDistance * breakEvenTriggerR
    breakEvenStopTouched = breakEvenArmed and confirmedBar and high >= entryPrice

    if stopTouched or targetTouched or breakEvenStopTouched or barsInTrade >= timeStopBars or longSignal
        strategy.close("AIQL-S")
    else if breakEvenTriggerTouched
        breakEvenArmed := true

// ===== Visual diagnostics =====
plot(fastEma, "EMA Fast")
plot(mediumEma, "EMA Medium")
plot(slowEma, "EMA Slow")

plotshape(longSignal and flatNow, title="LONG signal", style=shape.triangleup, location=location.belowbar, size=size.tiny, text="L")
plotshape(shortSignal and flatNow, title="SHORT signal", style=shape.triangledown, location=location.abovebar, size=size.tiny, text="S")
